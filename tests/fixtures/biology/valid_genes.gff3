##gff-version 3
##sequence-region chr1 1 300
##sequence-region chr2 1 120
##sequence-region chr3 1 60
# plus strand, two exons
chr1	.	gene	1	100	.	+	.	ID=g1
chr1	.	mRNA	1	100	.	+	.	ID=t1;Parent=g1
chr1	.	exon	1	30	.	+	.	Parent=t1
chr1	.	exon	51	100	.	+	.	Parent=t1
chr1	.	CDS	11	30	.	+	0	ID=cds1;Parent=t1
chr1	.	CDS	51	69	.	+	1	ID=cds1;Parent=t1
###
# minus strand, two exons
chr1	.	gene	201	300	.	-	.	ID=g2
chr1	.	mRNA	231	290	.	-	.	ID=t2;Parent=g2
chr1	.	exon	271	290	.	-	.	Parent=t2
chr1	.	exon	231	250	.	-	.	Parent=t2
chr1	.	CDS	271	285	.	-	0	ID=cds2;Parent=t2
chr1	.	CDS	231	245	.	-	0	ID=cds2;Parent=t2
###
# selenocysteine marked by a recoded_codon subtype (SO-Ontologies#658)
chr2	.	gene	1	30	.	+	.	ID=g3
chr2	.	mRNA	1	30	.	+	.	ID=t3;Parent=g3
chr2	.	CDS	1	30	.	+	0	ID=cds3;Parent=t3
chr2	.	stop_codon_redefined_as_selenocysteine	13	15	.	+	.	ID=sec3;Parent=cds3;recoded_amino_acid=selenocysteine
###
# selenocysteine marked by the legacy transl_except attribute
chr2	.	gene	61	90	.	+	.	ID=g4
chr2	.	mRNA	61	90	.	+	.	ID=t4;Parent=g4
chr2	.	CDS	61	90	.	+	0	ID=cds4;Parent=t4;transl_except=(pos:73..75%2Caa:Sec)
###
# recoded codon split by an intron: two lines with one ID
chr3	.	gene	1	40	.	+	.	ID=g5
chr3	.	mRNA	1	40	.	+	.	ID=t5;Parent=g5
chr3	.	exon	1	10	.	+	.	Parent=t5
chr3	.	exon	21	40	.	+	.	Parent=t5
chr3	.	CDS	1	10	.	+	0	ID=cds5;Parent=t5
chr3	.	CDS	21	37	.	+	2	ID=cds5;Parent=t5
chr3	.	recoded_codon	10	10	.	+	.	ID=rc5;Parent=cds5;recoded_amino_acid=selenocysteine
chr3	.	recoded_codon	21	22	.	+	.	ID=rc5;Parent=cds5;recoded_amino_acid=selenocysteine
